KOKORO_VOICES_PATH=models/voices-v1.0.bin
KOKORO_VOICE=pf_dora
KOKORO_LANG=pt-br

# Google Sheets (opcional — usar CSV local por padrão)
# GOOGLE_SHEETS_CREDENTIALS=config/credentials.json
# GOOGLE_SHEETS_ID=seu_sheet_id_aqui

# Dados da obra
CIDADE_OBRA="São Paulo"

TELEGRAM_BOT_TOKEN="token_aqui"
TELEGRAM_CHAT_ID="chat_id_aqui"

# OpenWeather (obter em https://openweathermap.org/api)
OPENWEATHER_API_KEY="sua_chave_aqui"

# Gmail SMTP (Etapa 2 — Canal de E-mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="seu_email@gmail.com"
SMTP_PASSWORD="sua_senha_de_app_aqui"
SMTP_FROM_NAME="Assistente de Obra IA"
